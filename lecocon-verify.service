[Unit]
Description=Le Cocon gender verification server (ONNX)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lecocon-deepface
ExecStart=/opt/lecocon-deepface/venv/bin/gunicorn --workers 1 --threads 1 --timeout 120 -b 0.0.0.0:8000 app:app
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
